  - {{ basis }} ({{ count }})
{% endfor %}
"""
import pytest

BASE_URL = "{{ base_url }}"

CASES = [
{% for c in cases %}
    {
        "case_id": {{ c.case_id|pyrepr }},
        "method": {{ c.method|pyrepr }},
        "path": {{ c.path|pyrepr }},
        "payload": {{ c.payload|pyrepr }},
        "headers": {{ c.headers|pyrepr }},
        "params": {{ c.params|pyrepr }},
        "expected": {{ c.expected_status }},
        "basis": {{ c.design_basis|pyrepr }},
    },
{% endfor %}
]


@pytest.mark.parametrize("case", CASES, ids=[c["case_id"] for c in CASES])
def test_contract(client, case):
    """断言「服务实际行为」与「设计契约」一致。"""
    resp = client.request(
        case["method"],
        BASE_URL + case["path"],
        json=case["payload"],
        headers=case["headers"],
        params=case["params"],
    )
    assert resp.status_code == case["expected"], (
        f"[kind=contract][case_id={case['case_id']}][basis={case['basis']}]"
        f"[expected={case['expected']}][actual={resp.status_code}] | {resp.text[:300]}"
    )
