# -*- coding: utf-8 -*-
"""AUTO-GENERATED by SmartTest - 跨接口场景测试

场景来源 : {{ provider_name }}
场景数量 : {{ scenarios|length }}
生成方式 : 模型/规则产出「数据」，由本解释器确定性执行。
           模型只能引用契约里已存在的 operationId，无法编造接口。
{% if degraded_reason %}
注意：模型不可用，已降级为规则推导。原因：{{ degraded_reason }}
{% endif %}
"""
import json
import re
from pathlib import Path

import pytest

BASE_URL = "{{ base_url }}"
SCENARIOS = json.loads(
    Path(__file__).with_name("scenarios.json").read_text(encoding="utf-8")
)

_VAR_PATTERN = re.compile(r"\{\{(\w+)\}\}")


def _resolve(value, variables):
    """把 {{变量}} 替换成前面步骤捕获到的值。"""
    if isinstance(value, str):
        return _VAR_PATTERN.sub(lambda m: str(variables.get(m.group(1), m.group(0))), value)
    if isinstance(value, dict):
        return {k: _resolve(v, variables) for k, v in value.items()}
    if isinstance(value, list):
        return [_resolve(v, variables) for v in value]
    return value


def _dig(payload, path):
    """极简 JSONPath：只支持 $.a.b 这种写法。"""
    current = payload
    for part in path.lstrip("$").lstrip(".").split("."):
        if not part:
            continue
        if not isinstance(current, dict) or part not in current:
            raise KeyError(f"响应中找不到字段 {path}")
        current = current[part]
    return current


@pytest.mark.parametrize("scenario", SCENARIOS, ids=[s["scenario_id"] for s in SCENARIOS])
def test_scenario(client, scenario):
    variables = {}
    prefix = f"[kind=business][case_id={scenario['scenario_id']}][basis={scenario['rationale']}]"

    for index, step in enumerate(scenario["steps"], 1):
        url = BASE_URL + _resolve(step["path"], variables)
        resp = client.request(
            step["method"],
            url,
            json=_resolve(step.get("body"), variables),
            headers=_resolve(step.get("headers") or {}, variables),
        )

        assert resp.status_code == step["expect_status"], (
            f"{prefix} 第 {index} 步 {step['operation_id']} 期望 {step['expect_status']} "
            f"实际 {resp.status_code} | {resp.text[:200]}"
        )

        try:
            payload = resp.json()
        except Exception:
            continue

        for name, json_path in (step.get("capture") or {}).items():
            variables[name] = _dig(payload, json_path)

        for json_path, expected in (step.get("expect_body") or {}).items():
            actual = _dig(payload, json_path)
            wanted = _resolve(expected, variables)
            assert str(actual) == str(wanted), (
                f"{prefix} 第 {index} 步 {json_path} 期望 {wanted} 实际 {actual}"
            )