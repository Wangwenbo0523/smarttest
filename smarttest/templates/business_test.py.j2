"""AUTO-GENERATED by SmartTest - 业务正确性测试（场景层）

契约测试只能验证「参数校验做得对不对」，验证不了「业务算得对不对」。
这一层补上跨接口流程与业务规则断言：

  - 金额精度（multipleOf 0.01）
  - 幂等语义（相同 Idempotency-Key 只创建一笔订单）

这两条需要领域知识，无法从 schema 推导，所以留在手写模板里。
而「状态机流转」「创建后查询一致」这类可从接口结构推导的场景，
已经交给语义增强层自动生成了。
"""
import pytest

BASE_URL = "{{ base_url }}"

# 生成期从被测服务实时探测到的商品数据，保证测试数据与被测系统一致
PRODUCTS = {{ products|pyrepr }}


@pytest.mark.parametrize("product", PRODUCTS, ids=[p["product_id"] for p in PRODUCTS])
def test_total_price_precision(client, product):
    """设计依据: 金额精度 —— 契约要求 total_price 满足 multipleOf 0.01。"""
    quantity = 3
    resp = client.post(
        BASE_URL + "/api/v1/orders",
        json={"product_id": product["product_id"], "quantity": quantity},
    )
    assert resp.status_code == 201, resp.text
    order = resp.json()

    expected = round(product["price"] * quantity, 2)
    assert order["total_price"] == expected, (
        f"[kind=business][case_id=total_price_precision][basis=money:exact_to_cent] "
        f"单价 {product['price']} x {quantity} 期望 {expected}，实际 {order['total_price']}"
    )


def test_idempotency_same_key_creates_one_order(client):
    """设计依据: 幂等语义 —— 相同 Idempotency-Key 重复提交只应产生一笔订单。"""
    headers = {"Idempotency-Key": "smarttest-idem-0001"}
    payload = {"product_id": {{ default_product_id|pyrepr }}, "quantity": 1}

    first = client.post(BASE_URL + "/api/v1/orders", json=payload, headers=headers)
    second = client.post(BASE_URL + "/api/v1/orders", json=payload, headers=headers)

    assert first.status_code == 201, first.text
    assert second.status_code == 201, second.text
    assert first.json()["order_id"] == second.json()["order_id"], (
        f"[kind=business][case_id=idempotency][basis=idempotency:same_key] "
        f"相同幂等键产生了不同订单: {first.json()['order_id']} != {second.json()['order_id']}"
    )
