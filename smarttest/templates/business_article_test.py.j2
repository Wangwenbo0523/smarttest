"""AUTO-GENERATED by SmartTest - 业务正确性测试（第三靶场：内容服务）

契约测试只能验证「参数校验做得对不对」，验证不了「业务规则对不对」。
这一层补上契约里写了、但 JSON Schema 推导不出来的两条存储语义：

  - tags 入库时去重，保留首次出现的顺序
  - 不传 status 时默认 DRAFT

两条都是「集合语义」与「默认值语义」，规则引擎只看单字段，推不出来。
"""
import pytest

BASE_URL = "{{ base_url }}"

# 契约声明 Authorization 必填，业务层用例同样不能漏
HEADERS = {"Authorization": "Bearer smarttest-token"}


def test_tags_are_deduplicated_in_order(client):
    """设计依据: 集合语义 —— tags 存储时去重，保留首次出现的顺序。"""
    resp = client.post(
        BASE_URL + "/api/v1/articles",
        json={
            "title": "标签去重测试",
            "tags": ["alpha", "alpha", "beta"],
            "author": {"name": "作者甲", "email": "author.a@example.com"},
        },
        headers=HEADERS,
    )
    assert resp.status_code == 201, resp.text
    stored = resp.json()["tags"]
    assert stored == ["alpha", "beta"], (
        f"[kind=business][case_id=tags_dedupe][basis=collection:dedupe_order] "
        f"tags 应按首次出现顺序去重，实际存储 {stored!r}"
    )


def test_status_defaults_to_draft(client):
    """设计依据: 默认值语义 —— 不传 status 时视为 DRAFT。"""
    resp = client.post(
        BASE_URL + "/api/v1/articles",
        json={
            "title": "默认状态测试",
            "author": {"name": "作者乙", "email": "author.b@example.com"},
        },
        headers=HEADERS,
    )
    assert resp.status_code == 201, resp.text
    actual = resp.json()["status"]
    assert actual == "DRAFT", (
        f"[kind=business][case_id=status_default][basis=default:status_draft] "
        f"不传 status 时应为 DRAFT，实际 {actual!r}"
    )
