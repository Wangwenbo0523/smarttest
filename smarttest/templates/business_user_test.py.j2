# -*- coding: utf-8 -*-
"""AUTO-GENERATED by SmartTest - 业务正确性测试（第二靶场：用户与订阅服务）

契约测试只能验证「参数校验做得对不对」，验证不了「业务规则对不对」。
这一层补上契约里写了、但 JSON Schema 推导不出来的跨字段与默认值语义：

  - 邮箱统一按小写存储
  - 不传 marketing_opt_in 时视为 false

这两条都不是单字段约束（规则引擎只看单字段），所以必须手写 ——
每个靶场的业务规则不同，这也正是业务层要按领域单独维护的原因。
"""
import pytest

BASE_URL = "{{ base_url }}"

# 契约声明 X-Tenant-Id 必填；业务层用例同样不能漏掉它
HEADERS = {"X-Tenant-Id": "tenant-0001"}


def test_email_is_normalized_to_lowercase(client):
    """设计依据: 邮箱归一 —— 契约声明服务端统一按小写存储。"""
    resp = client.post(
        BASE_URL + "/api/v1/users",
        json={"name": "归一测试", "email": "Mixed.Case@Example.COM", "plan_code": "PLAN-BASIC"},
        headers=HEADERS,
    )
    assert resp.status_code == 201, resp.text
    stored = resp.json()["email"]
    assert stored == "mixed.case@example.com", (
        f"[kind=business][case_id=email_normalized][basis=normalization:email_lowercase] "
        f"邮箱未被归一为小写，实际存储 {stored!r}"
    )


def test_marketing_opt_in_defaults_to_false(client):
    """设计依据: 默认值语义 —— 不传 marketing_opt_in 时视为 false。"""
    resp = client.post(
        BASE_URL + "/api/v1/users",
        json={"name": "默认值测试", "email": "default.optin@example.com", "plan_code": "PLAN-BASIC"},
        headers=HEADERS,
    )
    assert resp.status_code == 201, resp.text
    actual = resp.json().get("marketing_opt_in")
    assert actual is False, (
        f"[kind=business][case_id=marketing_opt_in_default][basis=default:marketing_opt_in] "
        f"不传该字段时的默认值应为 false，实际 {actual!r}"
    )
